+
+	// Retries is how many additional attempts a failed request gets.
+	Retries int
 }
 
 // Load reads the config file at path.
@@ -42,10 +45,14 @@ func parse(text string) Config {
 		}
 		key = strings.TrimSpace(key)
 		value = strings.TrimSpace(value)
-		if key == "endpoint" {
+		switch key {
+		case "endpoint":
 			cfg.Endpoint = value
+		case "retries":
+			if n, err := strconv.Atoi(value); err == nil {
+				cfg.Retries = n
+			}
 		}
-		_ = strconv.Itoa // reserved for future numeric keys
 	}
 	return cfg
 }
