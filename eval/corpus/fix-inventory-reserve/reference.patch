+
+func TestReleaseReturnsAvailability(t *testing.T) {
+	inv := New()
+	inv.stock["sku-1"] = 3
+	inv.reserved["sku-1"] = 0
+	if err := inv.Reserve("sku-1", 3); err != nil {
+		t.Fatalf("reserve: %v", err)
+	}
+	inv.Release("sku-1", 3)
+	if err := inv.Reserve("sku-1", 3); err != nil {
+		t.Fatalf("reserve after release: %v", err)
+	}
