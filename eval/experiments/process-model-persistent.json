{
	"name": "process-model-persistent",
	"model": "llm/deepseek-v4.1-flash",
	"temperature": 0,
	"process_model": "persistent",
	"corpus": [
		"staged-pipeline-build"
	],
	"runs_per_trajectory": {
		"stable": 3,
		"mid": 3,
		"uncharacterized": 3
	},
	"arms": {
		"control": {
			"config": {
				"options": {
					"notebook_enabled": false
				}
			}
		},
		"treatment": {
			"config": {
				"options": {
					"notebook_enabled": true,
					"notebook_pressure_gate": false
				}
			}
		}
	},
	"providers": {
		"llm": {
			"name": "Eval LLM",
			"type": "openai-compat",
			"api_key": "$LLM_API_KEY",
			"base_url": "$LLM_BASE_URL",
			"models": [
				{
					"id": "deepseek-v4.1-flash",
					"name": "DeepSeek V4.1 Flash",
					"context_window": 1000000,
					"default_max_tokens": 384000
				}
			]
		}
	},
	"primary": {
		"metric": "tokens.input",
		"direction": "decrease",
		"mde": 0.10
	},
	"hypothesis": "Process-model 2×2, persistent arm: one crush process runs the whole trajectory on one session — prefix cache, prior request vector, notebook high-water, and ledger state persist between turns exactly as in production TUI use. Paired with process-model-restart for the interaction read."
}
