{
	"name": "failure-memory-mask-inject-verify",
	"model": "llm/deepseek-v4.1-flash",
	"temperature": 0,
	"corpus": [
		"mask-ft-ambig-correct",
		"mask-bb-ambig-correct"
	],
	"runs_per_trajectory": {
		"stable": 2,
		"mid": 2,
		"uncharacterized": 2
	},
	"arms": {
		"control": {
			"config": {
				"options": {
					"turn_context": "off"
				}
			}
		},
		"treatment": {
			"config": {
				"options": {
					"turn_context": "off",
					"failure_memory": true
				}
			},
			"coverage": {
				"min_tail.decisions.pool.open.admitted": 1,
				"min_tail.sections.open_failures": 1
			}
		}
	},
	"providers": {
		"llm": {
			"name": "Eval LLM",
			"type": "openai-compat",
			"api_key": "$LLM_API_KEY",
			"base_url": "$LLM_BASE_URL",
			"models": [
				{
					"id": "deepseek-v4.1-flash",
					"name": "DeepSeek V4.1 Flash",
					"context_window": 1000000,
					"default_max_tokens": 384000
				}
			]
		}
	}
}
