{
	"name": "memory-loo-command",
	"model": "alibaba-tp/deepseek-v4.1-flash",
	"temperature": 0,
	"corpus": [
		"gen-m4k0-mid-explicit-d0-s001-*"
	],
	"runs_per_trajectory": {
		"uncharacterized": 12
	},
	"primary": {
		"metric": "steps",
		"direction": "increase",
		"mde": 0.15,
		"max_pass_drop": 0.1
	},
	"arms": {
		"control": {
			"config": {
				"options": {
					"turn_context": "off",
					"failure_memory": true,
					"failure_memory_edges": false
				}
			}
		},
		"treatment": {
			"config": {
				"options": {
					"turn_context": "off",
					"failure_memory": true,
					"failure_memory_edges": false,
					"memory_params": {
						"command_render_limit": 0
					}
				}
			}
		}
	},
	"decision_rule": {
		"hypothesis": "The command pool is load-bearing: suppressing it at fetch (zero render limit \u2014 no candidates, no decisions, no rendered section) costs the agent the rows that point at the fix. A pool whose removal costs nothing is a candidate for the simplify list.",
		"primary": {
			"metric": "steps",
			"arm": "treatment",
			"vs": "control",
			"direction": "increase",
			"min_improvement": 0.0
		},
		"guardrail": {
			"metric": "pass_rate",
			"min_delta": -0.1
		}
	},
	"providers": {
		"alibaba-tp": {
			"name": "Alibaba Token Plan",
			"type": "openai-compat",
			"api_key": "$ALIBABA_TP_API_KEY",
			"base_url": "https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1",
			"models": [
				{
					"id": "deepseek-v4.1-flash",
					"name": "DeepSeek V4.1 Flash",
					"context_window": 1000000,
					"default_max_tokens": 384000
				}
			]
		}
	}
}
