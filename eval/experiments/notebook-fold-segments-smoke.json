{
	"name": "notebook-fold-segments-smoke",
	"model": "llm/deepseek-v4.1-flash",
	"temperature": 0,
	"corpus": [
		"realrepo-*"
	],
	"runs_per_trajectory": {
		"stable": 1,
		"mid": 1,
		"uncharacterized": 1
	},
	"cost_weights": {
		"cache_read": 0.25,
		"cache_write": 0,
		"output": 4
	},
	"arms": {
		"control": {
			"config": {
				"options": {
					"notebook_enabled": false
				}
			}
		},
		"treatment": {
			"config": {
				"options": {
					"notebook_enabled": true,
					"notebook_prior_turns": "stub",
					"fold_turns": true,
					"fold_segments": true,
					"notebook_generate": "never",
					"notebook_checkpoint": false,
					"notebook_hydration": false,
					"notebook_auto_inject": false,
					"notebook_sync_mem0": false
				}
			},
			"coverage": {
				"min_prior_turns.segments_collapsed": 1
			}
		}
	},
	"providers": {
		"llm": {
			"name": "Eval LLM",
			"type": "openai-compat",
			"api_key": "$LLM_API_KEY",
			"base_url": "$LLM_BASE_URL",
			"models": [
				{
					"id": "deepseek-v4.1-flash",
					"name": "DeepSeek V4.1 Flash",
					"context_window": 1000000,
					"default_max_tokens": 384000
				}
			]
		}
	}
}
