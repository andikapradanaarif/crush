{
	"name": "warm-baseline",
	"model": "alibaba-tp/deepseek-v4.1-flash",
	"temperature": 0,
	"corpus": [
		"warm-fix-failing-test",
		"warm-startup-crash",
		"vague-fix-failing-test",
		"vague-startup-crash"
	],
	"runs_per_trajectory": {
		"stable": 1,
		"mid": 1,
		"uncharacterized": 1
	},
	"arms": {
		"control": {
			"config": {
				"options": {
					"turn_context": "off"
				}
			}
		},
		"treatment": {
			"config": {
				"options": {
					"turn_context": "session"
				}
			}
		}
	},
	"providers": {
		"alibaba-tp": {
			"name": "Alibaba Token Plan",
			"type": "openai-compat",
			"api_key": "$ALIBABA_TP_API_KEY",
			"base_url": "https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1",
			"models": [
				{
					"id": "deepseek-v4.1-flash",
					"name": "DeepSeek V4.1 Flash",
					"context_window": 1000000,
					"default_max_tokens": 384000
				}
			]
		}
	}
}
