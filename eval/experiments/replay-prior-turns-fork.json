{
	"name": "replay-prior-turns-fork",
	"model": "llm/deepseek-v4.1-flash",
	"temperature": 0,
	"corpus": [
		"staged-pipeline-build"
	],
	"runs_per_trajectory": {
		"stable": 3,
		"mid": 5,
		"uncharacterized": 3
	},
	"replay": {
		"source_arm": "control",
		"fork_turns": [4, 8, 12]
	},
	"arms": {
		"control": {
			"config": {
				"options": {
					"notebook_enabled": true,
					"notebook_pressure_gate": false,
					"notebook_prior_turns": "verbatim"
				}
			}
		},
		"treatment": {
			"config": {
				"options": {
					"notebook_enabled": true,
					"notebook_pressure_gate": false,
					"notebook_prior_turns": "stub"
				}
			},
			"coverage": {
				"min_prior_turns.turns_collapsed": 1
			}
		}
	},
	"providers": {
		"llm": {
			"name": "Eval LLM",
			"type": "openai-compat",
			"api_key": "$LLM_API_KEY",
			"base_url": "$LLM_BASE_URL",
			"models": [
				{
					"id": "deepseek-v4.1-flash",
					"name": "DeepSeek V4.1 Flash",
					"context_window": 1000000,
					"default_max_tokens": 384000
				}
			]
		}
	},
	"primary": {
		"metric": "steps",
		"direction": "decrease",
		"mde": 0.10
	},
	"hypothesis": "On byte-identical recorded prefixes (control arm), stub prior-turns changes the forked turn's step count and turn-start re-reads vs verbatim — the collapse-mechanism question, with prefix noise removed."
}
