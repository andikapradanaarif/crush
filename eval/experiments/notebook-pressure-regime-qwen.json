{
	"name": "notebook-pressure-regime-qwen",
	"model": "alibaba-tp/qwen3.8-flash",
	"temperature": 0,
	"corpus": [
		"realrepo-*@min_turns>=4"
	],
	"runs_per_trajectory": {
		"stable": 25,
		"mid": 25,
		"uncharacterized": 25
	},
	"primary": {
		"metric": "weighted_cost",
		"direction": "decrease",
		"mde": 0.15,
		"max_pass_drop": 0.1
	},
	"cost_weights": {
		"cache_read": 0.25,
		"output": 4
	},
	"arms": {
		"control": {
			"config": {
				"options": {
					"notebook_enabled": false,
					"disable_auto_summarize": false,
					"enforce_context_window": true
				}
			}
		},
		"treatment": {
			"config": {
				"options": {
					"notebook_enabled": true,
					"notebook_pressure_gate": true,
					"disable_auto_summarize": true,
					"enforce_context_window": true
				}
			},
			"coverage": {
				"min_pressure.activations": 1
			}
		}
	},
	"providers": {
		"alibaba-tp": {
			"name": "Alibaba Token Plan",
			"type": "openai-compat",
			"api_key": "$ALIBABA_TP_API_KEY",
			"base_url": "https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1",
			"models": [
				{
					"id": "qwen3.8-flash",
					"name": "Qwen 3.8 Flash",
					"context_window": 64000,
					"default_max_tokens": 8192
				}
			]
		}
	}
}
