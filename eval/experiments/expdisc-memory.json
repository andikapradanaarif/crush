{
	"name": "expdisc-memory",
	"model": "opencode-go/muse-spark-1.3-contributor",
	"temperature": 0,
	"corpus": [
		"expdisc-ft-ambig-correct",
		"expdisc-ft-ambig-decoy",
		"expdisc-bb-ambig-correct"
	],
	"runs_per_trajectory": {
		"stable": 3,
		"mid": 10,
		"uncharacterized": 11
	},
	"primary": {
		"metric": "call_metrics.discovery_calls_before_write",
		"direction": "decrease",
		"mde": 0.35,
		"max_pass_drop": 0.1
	},
	"arms": {
		"control": {
			"config": {
				"options": {
					"turn_context": "off"
				}
			}
		},
		"treatment": {
			"config": {
				"options": {
					"turn_context": "off",
					"failure_memory": true,
					"failure_memory_edges": false,
					"referent_memory": true,
					"session_memory": true
				}
			},
			"coverage": {
				"min_tail.decisions.candidates": 1
			}
		}
	},
	"providers": {}
}
