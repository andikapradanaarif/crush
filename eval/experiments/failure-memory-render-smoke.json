{
	"name": "failure-memory-render-smoke",
	"model": "alibaba-tp/deepseek-v4.1-flash",
	"temperature": 0,
	"corpus": [
		"warm-resolved-command-render"
	],
	"runs_per_trajectory": {
		"stable": 7,
		"mid": 7,
		"uncharacterized": 7
	},
	"primary": {
		"metric": "steps",
		"direction": "increase",
		"mde": 0.15,
		"max_pass_drop": 0.1
	},
	"arms": {
		"control": {
			"config": {
				"options": {
					"turn_context": "off",
					"failure_memory": false
				}
			}
		},
		"treatment": {
			"config": {
				"options": {
					"turn_context": "off",
					"failure_memory": true
				}
			},
			"coverage": {
				"min_tail.sections.command_memory": 1,
				"min_tail.sections.resolved_failures": 1
			}
		}
	},
	"providers": {
		"alibaba-tp": {
			"name": "Alibaba Token Plan",
			"type": "openai-compat",
			"api_key": "$ALIBABA_TP_API_KEY",
			"base_url": "https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1",
			"models": [
				{
					"id": "deepseek-v4.1-flash",
					"name": "DeepSeek V4.1 Flash",
					"context_window": 1000000,
					"default_max_tokens": 384000
				}
			]
		}
	}
}
