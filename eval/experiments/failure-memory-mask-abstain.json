{
	"name": "failure-memory-mask-abstain",
	"model": "alibaba-tp/deepseek-v4.1-flash",
	"temperature": 0,
	"corpus": [
		"mask-ft-ambig-none",
		"mask-bb-ambig-none"
	],
	"runs_per_trajectory": {
		"stable": 2,
		"mid": 3,
		"uncharacterized": 4
	},
	"primary": {
		"metric": "call_metrics.discovery_calls_before_write",
		"direction": "decrease",
		"mde": 0.35,
		"max_pass_drop": 0.1
	},
	"arms": {
		"control": {
			"config": {
				"options": {
					"turn_context": "off"
				}
			}
		},
		"treatment": {
			"config": {
				"options": {
					"turn_context": "off",
					"failure_memory": true
				}
			},
			"coverage": {
				"max_tail.sections.open_failures": 0,
				"max_tail.decisions.candidates": 0
			}
		}
	},
	"providers": {
		"alibaba-tp": {
			"name": "Alibaba Token Plan",
			"type": "openai-compat",
			"api_key": "$ALIBABA_TP_API_KEY",
			"base_url": "https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1",
			"models": [
				{
					"id": "deepseek-v4.1-flash",
					"name": "DeepSeek V4.1 Flash",
					"context_window": 1000000,
					"default_max_tokens": 384000
				}
			]
		}
	}
}
