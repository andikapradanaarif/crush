{
 "name": "failure-memory-mask-reject-ablation-edgeon",
 "model": "alibaba-tp/deepseek-v4.1-flash",
 "temperature": 0,
 "corpus": [
  "mask-ft-explicit-decoy",
  "mask-ft-explicit-stalefile",
  "mask-ft-ambig-stale",
  "mask-ft-ambig-placebo",
  "mask-bb-explicit-decoy",
  "mask-bb-ambig-stale",
  "mask-bb-ambig-placebo",
  "mask-fix-failing-test",
  "mask-build-break"
 ],
 "runs_per_trajectory": {
  "stable": 3,
  "mid": 10,
  "uncharacterized": 11
 },
 "primary": {
  "metric": "call_metrics.discovery_calls_before_write",
  "direction": "decrease",
  "mde": 0.35,
  "max_pass_drop": 0.1
 },
 "arms": {
  "control": {
   "config": {
    "options": {
     "turn_context": "off"
    }
   }
  },
  "treatment": {
   "config": {
    "options": {
     "turn_context": "off",
     "failure_memory": true,
     "failure_memory_edges": true
    }
   },
   "coverage": {
    "min_tail.decisions.candidates": 1,
    "max_tail.decisions.admitted": 0,
    "max_tail.sections.open_failures": 0
   }
  }
 },
 "providers": {
  "alibaba-tp": {
   "name": "Alibaba Token Plan",
   "type": "openai-compat",
   "api_key": "$ALIBABA_TP_API_KEY",
   "base_url": "https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1",
   "models": [
    {
     "id": "deepseek-v4.1-flash",
     "name": "DeepSeek V4.1 Flash",
     "context_window": 1000000,
     "default_max_tokens": 384000
    }
   ]
  }
 }
}
